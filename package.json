{
  "name": "coc-github-copilot",
  "version": "0.1.1",
  "description": "GitHub Copilot extension for coc.nvim",
  "author": "Qiming Zhao <chemzqm@gmail.com>",
  "license": "MIT",
  "repository": "https://github.com/neoclide/coc-github-copilot",
  "main": "lib/index.js",
  "keywords": [
    "coc.nvim",
    "github-copilot",
    "copilot",
    "neovim",
    "vim"
  ],
  "engines": {
    "coc": "^0.1.0"
  },
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "GitHub Copilot",
      "properties": {
        "github-copilot.enableCompletion": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "description": "Enable GitHub Copilot for inline completion"
        },
        "github-copilot.enableCompletionByLanguage": {
          "type": "object",
          "default": {},
          "scope": "application",
          "description": "Per-language completion overrides managed by the current-language enable, disable and toggle commands.",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "github-copilot.openPanelCommand": {
          "type": "string",
          "default": "keepalt vs",
          "scope": "application",
          "description": "Vim command to open github copilot completions panel for inline completion items."
        },
        "github-copilot.filetypes": {
          "type": [
            "array"
          ],
          "default": [
            "*"
          ],
          "scope": "application",
          "description": "Enabled filetypes, use \"*\" or null for all filetypes.",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "github-copilot.trace.server.verbosity": {
          "type": "string",
          "default": "messages",
          "enum": [
            "off",
            "messages",
            "compact",
            "verbose"
          ],
          "scope": "application",
          "description": "Trace level of communication between server and client"
        },
        "github-copilot.trace.server.format": {
          "type": "string",
          "default": "text",
          "enum": [
            "text",
            "json"
          ],
          "scope": "application",
          "description": "Text format of trace messages."
        },
        "github-copilot.statusIcon": {
          "type": "string",
          "default": "Copilot",
          "scope": "application",
          "description": "Status text, change to  if nerd font works on your vim."
        },
        "github-enterprise.uri": {
          "type": [
            "string",
            "null"
          ],
          "scope": "application",
          "default": null,
          "description": "If you are using GitHub Copilot Enterprise, set this to the URI of your GitHub Enterprise instance."
        },
        "github.copilot.selectedCompletionModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "The currently selected completion model ID. To select from a list of available models, use the __\"Change Completion Model\"__ command or open the model picker from the Copilot menu. The value must be a valid model ID. An empty value indicates that the default model will be used."
        }
      }
    },
    "commands": [
      {
        "title": "Sign in to Github Copilot",
        "command": "github-copilot.signIn"
      },
      {
        "title": "Sign out to Github Copilot",
        "command": "github-copilot.signOut"
      },
      {
        "title": "Open copilot completions panel",
        "command": "github-copilot.openPanel"
      },
      {
        "title": "Check GitHub Copilot status",
        "command": "github-copilot.status"
      },
      {
        "title": "Show GitHub Copilot diagnostics",
        "command": "github-copilot.diagnostics"
      },
      {
        "title": "Show GitHub Copilot quota",
        "command": "github-copilot.quota"
      },
      {
        "title": "Change GitHub Copilot completion model",
        "command": "github-copilot.changeCompletionModel"
      },
      {
        "title": "Enable GitHub Copilot completions",
        "command": "github-copilot.enable"
      },
      {
        "title": "Disable GitHub Copilot completions",
        "command": "github-copilot.disable"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types test/*.test.mts",
    "test:integration": "coc-test \"test/**/*.test.ts\"",
    "test:integration:nvim": "coc-test --nvim \"test/**/*.test.ts\"",
    "test:integration:vim": "coc-test --vim \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "node esbuild.js"
  },
  "dependencies": {
    "@github/copilot-language-server": "<2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "coc-test": "^0.1.8",
    "coc.nvim": "^0.0.83-next.27",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "coc-test": {
    "entryFile": "src/index.ts",
    "user-settings": {
      "github-copilot.enableCompletion": false,
      "nextEdit.autoTrigger": false,
      "github-copilot.filetypes": [
        "javascript"
      ]
    }
  }
}
